{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/writing-core/src/**/*.ts",
    "packages/writing-core/test/**/*.ts",
    "packages/writing-pack/src/**/*.ts",
    "packages/writing-pack/test/**/*.ts",
    "packages/application/src/**/*.ts",
    "packages/application/test/**/*.ts",
    "packages/legacy-migration/src/**/*.ts",
    "packages/legacy-migration/test/**/*.ts",
    "packages/client-bridge/src/application-bridge.ts",
    "packages/client-bridge/src/local-web-host.ts",
    "packages/client-bridge/src/protocol.ts",
    "packages/client-bridge/src/ui-settings-persistence.ts",
    "packages/client-bridge/test/application-bridge.test.ts",
    "packages/client-bridge/test/local-web-host.test.ts",
    "packages/client-bridge/test/ui-settings-persistence.test.ts",
    "packages/storage/src/**/*.ts",
    "packages/storage/test/**/*.ts",
    "packages/runtime/llm/src/**/*.ts",
    "packages/runtime/llm/test/**/*.ts",
    "packages/runtime/credentials/src/**/*.ts",
    "packages/runtime/credentials/test/**/*.ts",
    "packages/runtime/diagnostics/src/**/*.ts",
    "packages/runtime/diagnostics/test/**/*.ts",
    "packages/runtime/provider-config/src/**/*.ts",
    "packages/runtime/provider-config/test/**/*.ts",
    "packages/runtime/tools/src/**/*.ts",
    "packages/runtime/tools/test/**/*.ts",
    "packages/runtime/session/src/**/*.ts",
    "packages/runtime/session/test/**/*.ts",
    "packages/runtime/recovery/src/**/*.ts",
    "packages/runtime/recovery/test/**/*.ts",
    "packages/runtime/agent/src/**/*.ts",
    "packages/runtime/agent/test/**/*.ts",
    "apps/cli/src/**/*.ts",
    "apps/cli/test/**/*.ts",
    "apps/web/server/**/*.ts",
    "packages/model-adapters/openai-compatible/src/**/*.ts",
    "packages/model-adapters/openai-compatible/test/**/*.ts",
    "packages/model-adapters/anthropic-compatible/src/**/*.ts",
    "packages/model-adapters/anthropic-compatible/test/**/*.ts"
  ]
}
