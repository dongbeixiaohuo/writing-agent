{
  "workflow_version": "collab-v2",
  "final_copy_artifact": "_clean.txt",
  "notes_suffix": "_notes.md",
  "legacy_aliases": {
    "02_cases.md": "02_scar_tissue.md",
    "04_empathy_map.md": "04_share_map.md"
  },
  "modes": {
    "A": {
      "description": "轻量模式：澄清后直接写作，可选简单审稿",
      "stage_sequence": [
        "1",
        "6",
        "7"
      ],
      "stage_overrides": {
        "6": {
          "inputs": [
            "01_theme.md"
          ]
        },
        "7": {
          "optional": true
        }
      }
    },
    "B": {
      "description": "协作模式：使用完整 stages 契约",
      "stage_sequence_source": "stages"
    },
    "C": {
      "description": "选题模式：生成候选、验证选题，然后交接协作模式",
      "stage_sequence": [
        "0a",
        "0b",
        "1"
      ],
      "stages": [
        {
          "id": "0a",
          "agent": "topic-generator",
          "inputs": [
            "articles/_topic_pool/"
          ],
          "outputs": [
            "articles/_topic_pool/[YYYY-MM-DD-HHmm]-topic-candidates.md"
          ]
        },
        {
          "id": "0b",
          "agent": "topic-research",
          "inputs": [
            "[topic_candidates_file]"
          ],
          "outputs": [
            "articles/_topic_pool/[YYYY-MM-DD-HHmm]-topic-validation.md"
          ]
        }
      ],
      "handoff": {
        "after_stage": "0b",
        "to_mode": "B",
        "to_stage": "1"
      }
    }
  },
  "interaction_policy": {
    "default_after_stage": "wait_for_user",
    "automatic_transitions": [
      {
        "from": "9",
        "to": "10",
        "condition": "用户批准 Stage 9 结果"
      },
      {
        "from": "10",
        "to": "10.5",
        "condition": "Humanizer 完成"
      },
      {
        "from": "11",
        "to": "12",
        "condition": "用户的 Y/N 选择已处理；选择 Y 时配图已完成"
      },
      {
        "from": "12",
        "to": "12.5",
        "condition": "纯净版文件已生成"
      },
      {
        "from": "12.5",
        "to": "13",
        "condition": "HTML 选择已处理；选择导出时 HTML 已生成"
      }
    ],
    "terminal_stage": "13"
  },
  "post_publish_stages": [
    {
      "id": "14",
      "agent": "performance-review",
      "trigger": "user_explicit",
      "inputs": [
        "publication_metrics.jsonl"
      ],
      "outputs": [
        "performance_reviews/[YYYY-MM-DD-HHmm]-[record_id].md"
      ]
    }
  ],
  "stages": [
    {
      "id": "1",
      "agent": "writing-clarifier",
      "outputs": [
        "01_theme.md"
      ]
    },
    {
      "id": "0",
      "agent": "memory-loader",
      "inputs": [
        "01_theme.md"
      ],
      "outputs": [
        "00_memory_packet.md"
      ]
    },
    {
      "id": "1.5",
      "agent": "position-engine",
      "inputs": [
        "01_theme.md"
      ],
      "outputs": [
        "01b_position.md"
      ]
    },
    {
      "id": "2",
      "agent": "research-expert",
      "inputs": [
        "01_theme.md",
        "01b_position.md"
      ],
      "outputs": [
        "02_scar_tissue.md",
        "02_evidence_ledger.json"
      ]
    },
    {
      "id": "3",
      "agent": "outline-architect",
      "inputs": [
        "01_theme.md",
        "00_memory_packet.md",
        "01b_position.md",
        "02_scar_tissue.md"
      ],
      "outputs": [
        "03_outline.md"
      ]
    },
    {
      "id": "4",
      "agent": "empathy-designer",
      "inputs": [
        "01_theme.md",
        "03_outline.md",
        "01b_position.md",
        "02_scar_tissue.md"
      ],
      "outputs": [
        "04_share_map.md"
      ]
    },
    {
      "id": "5",
      "agent": "concretizer",
      "inputs": [
        "03_outline.md",
        "04_share_map.md"
      ],
      "outputs": [
        "05_concrete_library.md"
      ]
    },
    {
      "id": "5.5",
      "agent": "title-designer",
      "inputs": [
        "01_theme.md",
        "00_memory_packet.md",
        "01b_position.md",
        "02_evidence_ledger.json",
        "03_outline.md"
      ],
      "outputs": [
        "04_title.md"
      ]
    },
    {
      "id": "5.8",
      "agent": "opening-tournament",
      "inputs": [
        "01_theme.md",
        "01b_position.md",
        "02_scar_tissue.md",
        "02_evidence_ledger.json",
        "03_outline.md",
        "04_title.md",
        "04_share_map.md",
        "05_concrete_library.md"
      ],
      "outputs": [
        "05c_opening_hook.md"
      ]
    },
    {
      "id": "6",
      "agent": "writing-executor",
      "inputs": [
        "01_theme.md",
        "00_memory_packet.md",
        "01b_position.md",
        "02_scar_tissue.md",
        "02_evidence_ledger.json",
        "03_outline.md",
        "04_title.md",
        "04_share_map.md",
        "05_concrete_library.md",
        "05c_opening_hook.md"
      ],
      "outputs": [
        "draft_v1.md",
        "draft_v1_notes.md"
      ]
    },
    {
      "id": "7",
      "agent": "editor-review",
      "outputs": [
        "draft_vN.md",
        "draft_vN_notes.md"
      ]
    },
    {
      "id": "8",
      "agent": "pre-publish-review",
      "outputs": [
        "pre_publish_review.md"
      ]
    },
    {
      "id": "9",
      "agent": "wechat-reader-test",
      "inputs": [
        "01_theme.md",
        "04_title.md",
        "[latest_body_file]"
      ],
      "outputs": [
        "wechat_reader_test.md"
      ]
    },
    {
      "id": "10",
      "agent": "humanizer",
      "inputs": [
        "01_theme.md",
        "00_memory_packet.md",
        "02_evidence_ledger.json",
        "04_title.md",
        "[latest_body_file]"
      ],
      "outputs": [
        "draft_vN_humanized.md"
      ]
    },
    {
      "id": "10.5",
      "agent": "fact-checker",
      "inputs": [
        "02_evidence_ledger.json",
        "04_title.md",
        "[latest_body_file]"
      ],
      "outputs": [
        "fact_claims.json",
        "fact_check_report.md"
      ]
    },
    {
      "id": "11",
      "agent": "article-illustrator",
      "optional": true,
      "outputs": []
    },
    {
      "id": "12",
      "agent": "auto-clean-hook",
      "outputs": [
        "[body]_clean.txt"
      ]
    },
    {
      "id": "12.5",
      "agent": "html-exporter",
      "optional": true,
      "outputs": [
        "[body].html"
      ]
    },
    {
      "id": "13",
      "agent": "edit-diff-learner",
      "outputs": [
        "99_episode.md"
      ]
    }
  ]
}
